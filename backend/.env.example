# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local MongoDB installation:
MONGODB_URI=mongodb://localhost:27017/tourist-safety-db
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tourist-safety-db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# ---- New configuration for Trip/Location/Geofence/Risk/Battery features ----
# NOTE: none of these are hard-coded in application code - change them here.

# Feature 5: how long (seconds) after the last update a tourist is still "LIVE"
# vs "LAST_KNOWN" vs fully "OFFLINE"
LOCATION_LIVE_THRESHOLD_SECONDS=120
LOCATION_OFFLINE_THRESHOLD_SECONDS=900

# Feature 12: battery percentage at/below which a LOW_BATTERY incident is raised
LOW_BATTERY_THRESHOLD_PERCENT=15

# Feature 11: AI Risk Engine (DEMO RULES - hybrid rule-based/statistical, not a trained ML model)
RISK_UNUSUAL_STOP_MINUTES=30
RISK_UNUSUAL_STOP_RADIUS_M=40
RISK_ABNORMAL_SPEED_MPS=30
RISK_DIRECTION_CHANGE_DEG=150
RISK_ROUTE_DEVIATION_M=500
RISK_BOUNDARY_APPROACH_WINDOW_MIN=60
RISK_BOUNDARY_APPROACH_COUNT=3
RISK_HISTORY_POINTS=30

# New (Module 18 - added only because genuinely necessary):
# How often (ms) the background offline-location watcher scans active trips
LOCATION_STATUS_CHECK_INTERVAL_MS=60000
# Statistical anomaly z-score threshold for the StatisticalRiskProvider
RISK_SPEED_ZSCORE_THRESHOLD=2.5
# How many consecutive points must all deviate from the planned route before
# route deviation is flagged (prevents a single bad GPS fix from triggering it)
RISK_ROUTE_DEVIATION_SUSTAINED_POINTS=3

# Email Configuration (for future use)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# SMS Configuration (for future use)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=your-twilio-phone
